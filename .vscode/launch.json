{
  // Two configs, two journeys (see DEVELOPMENT.md):
  //
  //   Bootstrap complet   creates + populates .runtime/ (once per clone / per
  //                        runtime version) and wires it — journeys 0+1.
  //   Deploy → cible       builds the selected pages and deploys them onto a
  //                        WinCC OA project — journey 3.
  //
  // Everything else (dev server, raw builds, tests, deploy variants) lives as
  // tasks in .vscode/tasks.json — this file only keeps the two entry points
  // worth a one-click Run & Debug launch.
  "version": "0.2.0",
  "inputs": [
    {
      // PIN IT to the runtime version of the TARGET project: a page bundle is
      // welded to the import map of the shell that built it. `latest` is fine
      // for a first look, not for a deploy.
      "id": "runtimeVersion",
      "type": "promptString",
      "description": "Version de @wincc-oa/webui-runtime (celle de la cible ; latest = dernière)",
      "default": "latest"
    },
    {
      "id": "oaProject",
      "type": "promptString",
      "description": "WinCC OA project root (contains data/, javascript/, config/)",
      "default": "../wui-scada-project"
    }
  ],
  "configurations": [
    {
      // ---- journey 0+1: first clone / repair --------------------------------
      // Creates .runtime/ (npm install @wincc-oa/webui-runtime + webui-runtime-init
      // + init:oa-data) if it isn't there yet, then chains wire-workspace.mjs.
      // Idempotent — safe to re-run after adding/removing a page lib.
      "name": "Bootstrap complet (créer + peupler .runtime)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/bootstrap-workspace.mjs",
      "args": ["--version", "${input:runtimeVersion}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // ---- journey 3: deploy -------------------------------------------------
      // Interactive: pick the project, the modules, the landing page, the AI
      // flag. Each answer is pre-filled with what you chose last time for this
      // project. integratedTerminal is required — the script uses readline.
      //
      // On a project where the shell isn't deployed yet or the webserver isn't
      // installed, it stops and tells you to re-run with --full / with
      // --install-webserver — add those to `args` here for that one run.
      "name": "Deploy → cible (interactif)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/scripts/deploy-release.mjs",
      "args": ["--project", "${input:oaProject}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
