{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "Bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "baseUrl": ".",
    "incremental": true,
    "moduleDetection": "auto",
    "paths": {
      "@visuelconcept-winccoa/wui-agv-fleet/*": [
        "libs/wui-agv-fleet/src/*"
      ],
      "@visuelconcept-winccoa/wui-ai-kit/*": [
        "libs/wui-ai-kit/src/*"
      ],
      "@visuelconcept-winccoa/wui-alarms/*": [
        "libs/wui-alarms/src/*"
      ],
      "@visuelconcept-winccoa/wui-alarms-core/*": [
        "libs/wui-alarms-core/src/*"
      ],
      "@visuelconcept-winccoa/wui-ampere/*": [
        "libs/wui-ampere/src/*"
      ],
      "@visuelconcept-winccoa/wui-app-security/*": [
        "libs/wui-app-security/src/*"
      ],
      "@visuelconcept-winccoa/wui-audit-trail/*": [
        "libs/wui-audit-trail/src/*"
      ],
      "@visuelconcept-winccoa/wui-camera-streams/*": [
        "libs/wui-camera-streams/src/*"
      ],
      "@visuelconcept-winccoa/wui-diagnosis/*": [
        "libs/wui-diagnosis/src/*"
      ],
      "@visuelconcept-winccoa/wui-eng-core/*": [
        "libs/wui-eng-core/src/*"
      ],
      "@visuelconcept-winccoa/wui-eng-studio/*": [
        "libs/wui-eng-studio/src/*"
      ],
      "@visuelconcept-winccoa/wui-fleet-closures/*": [
        "libs/wui-fleet-closures/src/*"
      ],
      "@visuelconcept-winccoa/wui-fleet-core/*": [
        "libs/wui-fleet-core/src/*"
      ],
      "@visuelconcept-winccoa/wui-fleet-kpi-analysis/*": [
        "libs/wui-fleet-kpi-analysis/src/*"
      ],
      "@visuelconcept-winccoa/wui-fleet-stop-analysis/*": [
        "libs/wui-fleet-stop-analysis/src/*"
      ],
      "@visuelconcept-winccoa/wui-gis/*": [
        "libs/wui-gis/src/*"
      ],
      "@visuelconcept-winccoa/wui-kit/*": [
        "libs/wui-kit/src/*"
      ],
      "@visuelconcept-winccoa/wui-machine-fleet-3d/*": [
        "libs/wui-machine-fleet-3d/src/*"
      ],
      "@visuelconcept-winccoa/wui-mosaic/*": [
        "libs/wui-mosaic/src/*"
      ],
      "@visuelconcept-winccoa/wui-para/*": [
        "libs/wui-para/src/*"
      ],
      "@visuelconcept-winccoa/wui-process-monitor/*": [
        "libs/wui-process-monitor/src/*"
      ],
      "@visuelconcept-winccoa/wui-production-orders/*": [
        "libs/wui-production-orders/src/*"
      ],
      "@visuelconcept-winccoa/wui-remote-vnc/*": [
        "libs/wui-remote-vnc/src/*"
      ],
      "@visuelconcept-winccoa/wui-report-builder/*": [
        "libs/wui-report-builder/src/*"
      ],
      "@visuelconcept-winccoa/wui-report-templates/*": [
        "libs/wui-report-templates/src/*"
      ],
      "@visuelconcept-winccoa/wui-tag-importer/*": [
        "libs/wui-tag-importer/src/*"
      ],
      "@visuelconcept-winccoa/wui-thermal-reports/*": [
        "libs/wui-thermal-reports/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp",
    ".runtime"
  ]
}
