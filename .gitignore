# =============================================================================
# winccoa-wui-pages — a wui-toolkit site whose libs/wui-<id>/ are published as
# independent npm packages; `wui dev` / `wui test` run them, nothing is deployed here.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies (the root workspaces install, a lib's own: libs/wui-eng-studio/demo…)
# -----------------------------------------------------------------------------
node_modules/

# -----------------------------------------------------------------------------
# Build / pack output
# -----------------------------------------------------------------------------
dist/
*.tgz
*.tar.gz
**/.tsbuildinfo
vite.config.*.timestamp*
vitest.config.*.timestamp*

# -----------------------------------------------------------------------------
# Test artifacts
# -----------------------------------------------------------------------------
coverage/
**/test-results/
**/*test-report.xml

# -----------------------------------------------------------------------------
# Environment & secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
# The root .npmrc maps the scope to GitHub Packages and holds no token (committed);
# tokens live in ~/.npmrc. A .npmrc anywhere else stays local.
libs/**/.npmrc

# -----------------------------------------------------------------------------
# IDE & editors
# -----------------------------------------------------------------------------
.idea/
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.launch
.project
.classpath
.c9/
.settings/

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
**/custom-elements.json
tmp/

# -----------------------------------------------------------------------------
# Leftovers of the former runtime workspace (.runtime/ + Nx) — delete them locally;
# ignored so they cannot be committed by mistake.
# -----------------------------------------------------------------------------
/.runtime/
.nx/
/apps/
/oa-data/
/libs/default-components/

# WinCC OA runtime skills — third-party, copied by `wui skills` (postinstall)
.claude/skills/winccoa-*/
.ai/skills/winccoa-*/
.github/prompts/winccoa-*.prompt.md

# -----------------------------------------------------------------------------
# Third-party IP — MUST NOT be published under this project's license.
# (See IP_AUDIT.md. Kept out of the open-source repo; not authored by Visuel Concept.)
# -----------------------------------------------------------------------------
# WinCC OA project archive: contains Siemens/WinCC-OA-SDK-derived .ctl scripts,
# GEDI panels and a WinCC OA logo. Referenced only in comments (legacy model).
/winccoa_projectmanager.zip
