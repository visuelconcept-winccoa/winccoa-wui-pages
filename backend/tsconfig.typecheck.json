{
  // Offline typecheck of the Engineering Studio backend — no WinCC OA needed.
  //   cd libs/wui-eng-core && ./node_modules/.bin/tsc -p ../../backend/tsconfig.typecheck.json
  // (run from wui-eng-core: that is where the dev TypeScript and @types/node live)
  //
  // The webserver packages come from ./types/runtime-stubs.d.ts, but
  // @visuelconcept/wui-eng-core resolves to its REAL sources — so this checks the
  // controller against the actual engineering API, which is the part that matters.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["../libs/wui-eng-core/node_modules/@types"],
    "baseUrl": ".",
    // At deploy time a module's own backend/ files and its `shared` ones
    // (appSecurityGuard.ts, owned by wui-app-security) land in ONE folder, so
    // `import './appSecurityGuard'` is relative. rootDirs reproduces that merge.
    "rootDirs": ["../libs/wui-eng-studio/backend", "../libs/wui-app-security/backend"],
    "paths": {
      "@visuelconcept/wui-eng-core": ["../libs/wui-eng-core/src/index.ts"],
      "@visuelconcept/wui-eng-core/*": ["../libs/wui-eng-core/src/*"]
    }
  },
  // The route sources live in the modules that own them (libs/wui-<page>/backend/).
  "include": [
    "types/**/*.d.ts",
    "../libs/wui-eng-studio/backend/engRoute.ts",
    "../libs/wui-eng-studio/backend/engController.ts",
    "../libs/wui-eng-studio/backend/engOpcuaBrowse.ts",
    "../libs/wui-eng-studio/backend/engStore.ts",
    "../libs/wui-app-security/backend/appSecurityGuard.ts"
  ]
}
