{
  "name": "@visuelconcept/wui-dp-watch",
  "type": "module",
  "version": "0.1.0",
  "description": "DP Watch — standalone WinCC OA WebUI page and embeddable element: live values of every datapoint element matching a pattern (dpNames + dpConnect). Read-only; ships its own mock fixtures for `wui dev`.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page"
  ],
  "license": "MIT",
  "dependencies": {
    "@visuelconcept/wui-kit": "*"
  },
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "tsyringe": "*",
    "@etm-professional-control/oa-rx-js-api": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-models": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "route": "/dp-watch",
    "routeId": "dp-watch",
    "component": "wui-dp-watch",
    "module": "/data/dashboard-wc/pages/dp-watch.js",
    "icon": "eye",
    "permission": ["connected"],
    "tier": 1
  }
}
