{
  "name": "@visuelconcept-winccoa/wui-gis",
  "type": "module",
  "version": "0.1.2",
  "description": "GIS — standalone WinCC OA WebUI page: map-based monitoring on MapLibre GL / OpenStreetMap (no licence cost). One GIS_Site datapoint per site, holding geo-located assets bound to datapoints, areas (districts / sectors / catchments) grouping them, live value overlays, alarm highlighting from the OA alert state and a configurable drill-down from map to area to asset to its process or 3D view.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page",
    "gis",
    "map",
    "maplibre"
  ],
  "license": "MIT",
  "dependencies": {
    "@visuelconcept-winccoa/wui-ai-kit": "^0.1.0",
    "@visuelconcept-winccoa/wui-kit": "^0.1.0",
    "maplibre-gl": "^5.24.0",
    "@visuelconcept-winccoa/wui-para": "^0.1.0",
    "@visuelconcept-winccoa/wui-app-security": "^0.1.0"
  },
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "tsyringe": "*",
    "@etm-professional-control/oa-rx-js-api": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-ix-wrappers": "*",
    "@wincc-oa/wui-models": "*",
    "@wincc-oa/wui-oarxjs-context": "*",
    "@wincc-oa/wui-shared": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "requires": [
      "para",
      "app-security"
    ],
    "optional": [
      "machine-fleet-3d"
    ],
    "route": "/gis",
    "routes": [
      "/gis",
      "/gis/:siteid"
    ],
    "routeId": "gis",
    "component": "wui-gis",
    "module": "/data/dashboard-wc/pages/gis.js",
    "icon": "map",
    "permission": [
      "connected"
    ],
    "tier": 1,
    "datapoints": {
      "type": "GIS_Site",
      "prefix": "GIS_",
      "note": "One datapoint per site (Struct with String elements name + json), auto-created through /api/para on first use. Assets bind freely to existing project datapoints — the page creates none of them. Falls back to two in-memory demo sites (water network, smart city district) when no GIS_Site datapoint exists."
    }
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "tsyringe": {
      "optional": true
    },
    "@etm-professional-control/oa-rx-js-api": {
      "optional": true
    },
    "@wincc-oa/wui-i18n-shared": {
      "optional": true
    },
    "@wincc-oa/wui-ix-wrappers": {
      "optional": true
    },
    "@wincc-oa/wui-models": {
      "optional": true
    },
    "@wincc-oa/wui-oarxjs-context": {
      "optional": true
    },
    "@wincc-oa/wui-shared": {
      "optional": true
    }
  },
  "files": [
    "src",
    "menu.fragment.jsonc",
    "!**/*.spec.ts",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept-winccoa/winccoa-wui-pages.git",
    "directory": "libs/wui-gis"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
