{
  "name": "@visuelconcept-winccoa/wui-fleet-closures",
  "type": "module",
  "version": "0.1.1",
  "description": "Fleet Closures — standalone WinCC OA WebUI page: manage non-worked periods (jours non travaillés) per atelier/machine, used as the TRS opening-time denominator by the KPI page. One app-level JSON datapoint. Its backend, /api/fleet, carries the writes of every Machine Fleet page (ateliers, graphics resources, stop causes, non-worked periods, archive config of a bound datapoint), each checked on the server against the role it needs.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page"
  ],
  "license": "MIT",
  "dependencies": {
    "@visuelconcept-winccoa/wui-fleet-core": "^0.1.0",
    "@visuelconcept-winccoa/wui-kit": "^0.1.0",
    "@visuelconcept-winccoa/wui-para": "^0.1.0",
    "@visuelconcept-winccoa/wui-app-security": "^0.1.0"
  },
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-ix-wrappers": "*",
    "@wincc-oa/wui-models": "*",
    "@wincc-oa/wui-oarxjs-context": "*",
    "@wincc-oa/wui-shared": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "requires": [
      "para",
      "app-security"
    ],
    "route": "/fleet-closures",
    "routeId": "fleet-closures",
    "component": "wui-fleet-closures",
    "module": "/data/dashboard-wc/pages/fleet-closures.js",
    "hidden": true,
    "tier": 1,
    "backend": {
      "mount": "/api/fleet",
      "routeClass": "FleetRoute",
      "routeFile": "fleetRoute",
      "files": [
        "fleetRoute.ts",
        "fleetController.ts",
        "fleetRules.ts"
      ],
      "shared": [
        "@visuelconcept-winccoa/wui-app-security/appSecurityGuard.ts",
        "@visuelconcept-winccoa/wui-para/paraTypeNode.ts"
      ],
      "notes": [
        "/api/fleet/dp/set, /dp/create, DELETE /dp/:name, /dptype/create: only the Fleet's datapoints (MachineFleet3D*) and the _archive config of a bound datapoint, each against its role (machine-fleet-3d edit; fleet-closures edit, or edit-machine for a single machine's periods); anything else 403",
        "role check effective once the webserver has HTTP authentication (otherwise skipped and logged, as requireRole); without this backend the Fleet store writes through /api/para"
      ]
    }
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@wincc-oa/wui-i18n-shared": {
      "optional": true
    },
    "@wincc-oa/wui-ix-wrappers": {
      "optional": true
    },
    "@wincc-oa/wui-models": {
      "optional": true
    },
    "@wincc-oa/wui-oarxjs-context": {
      "optional": true
    },
    "@wincc-oa/wui-shared": {
      "optional": true
    }
  },
  "files": [
    "backend",
    "src",
    "menu.fragment.jsonc",
    "!**/*.spec.ts",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept-winccoa/winccoa-wui-pages.git",
    "directory": "libs/wui-fleet-closures"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
