{
  "name": "@visuelconcept-winccoa/wui-diagnosis",
  "type": "module",
  "version": "0.1.1",
  "description": "Diagnosis — standalone WinCC OA WebUI page: read-only system health (time, licenses, OA version, API/heartbeat, browser, service-worker, memory/disk) via context generators. Pure client, no backend beyond the standard WebUI connection.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lit": "*",
    "@wincc-oa/wui-ix-wrappers": "*",
    "@wincc-oa/wui-oarxjs-context": "*",
    "@wincc-oa/wui-widgets": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "route": "/status",
    "routeId": "status",
    "component": "wui-diagnosis",
    "module": "/data/dashboard-wc/pages/diagnosis.js",
    "icon": "maintenance-info-filled",
    "tier": 1
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "@wincc-oa/wui-ix-wrappers": {
      "optional": true
    },
    "@wincc-oa/wui-oarxjs-context": {
      "optional": true
    },
    "@wincc-oa/wui-widgets": {
      "optional": true
    }
  },
  "files": [
    "src",
    "menu.fragment.jsonc",
    "!**/*.spec.ts",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept-winccoa/winccoa-wui-pages.git",
    "directory": "libs/wui-diagnosis"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
