{
  "name": "@visuelconcept-winccoa/wui-fleet-core",
  "type": "module",
  "version": "0.1.1",
  "description": "Shared fleet domain for the Machine Fleet pages: the atelier/machine/stop-cause domain model (types), the FleetStore persistence + offline fallback, the stop-cause analysis engine, closures (opening-time) model, the stop-cause catalog editor and the shared page styles.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents"
  ],
  "license": "MIT",
  "dependencies": {
    "@visuelconcept-winccoa/wui-kit": "^0.1.0",
    "three": "^0.169.0"
  },
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "tsyringe": "*",
    "@etm-professional-control/oa-rx-js-api": "*",
    "@wincc-oa/wui-data-selector-data": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-models": "*",
    "@wincc-oa/wui-shared": "*"
  },
  "exports": {
