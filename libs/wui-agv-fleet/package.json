{
  "name": "@visuelconcept-winccoa/wui-agv-fleet",
  "type": "module",
  "version": "0.1.0",
  "description": "AGV Fleet — standalone WinCC OA WebUI page: live supervision of an AGV fleet (one AGV_Vehicle datapoint per vehicle) with a KPI bar, a status list and a warehouse floor-plan map.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page",
    "agv"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "tsyringe": "*",
    "@etm-professional-control/oa-rx-js-api": "*",
    "@wincc-oa/wui-data-selector-data": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-iam-data": "*",
    "@wincc-oa/wui-ix-wrappers": "*",
    "@wincc-oa/wui-models": "*",
    "@wincc-oa/wui-oarxjs-context": "*",
    "@wincc-oa/wui-shared": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "route": "/agv-fleet",
    "routes": [
      "/agv-fleet"
    ],
    "routeId": "agv-fleet",
    "component": "wui-agv-fleet",
    "module": "/data/dashboard-wc/pages/agv-fleet.js",
    "icon": "truck",
    "permission": [
      "connected"
    ],
    "tier": 1,
    "datapoints": {
      "type": "AGV_Vehicle",
      "prefix": "AGV_",
      "note": "One datapoint per vehicle; read-only supervision. The page falls back to an in-memory demo fleet when no AGV_Vehicle datapoint exists."
    },
    "backend": {
      "managers": [
        "agvSim"
      ]
    }
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "tsyringe": {
      "optional": true
    },
    "@etm-professional-control/oa-rx-js-api": {
      "optional": true
    },
    "@wincc-oa/wui-data-selector-data": {
      "optional": true
    },
    "@wincc-oa/wui-i18n-shared": {
      "optional": true
    },
    "@wincc-oa/wui-iam-data": {
      "optional": true
    },
    "@wincc-oa/wui-ix-wrappers": {
      "optional": true
    },
    "@wincc-oa/wui-models": {
      "optional": true
    },
    "@wincc-oa/wui-oarxjs-context": {
      "optional": true
    },
    "@wincc-oa/wui-shared": {
      "optional": true
    }
  },
  "files": [
    "src",
    "managers",
    "menu.fragment.jsonc",
    "!**/*.spec.ts",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept-winccoa/winccoa-wui-pages.git",
    "directory": "libs/wui-agv-fleet"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
