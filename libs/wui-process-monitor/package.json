{
  "name": "@visuelconcept-winccoa/wui-process-monitor",
  "type": "module",
  "version": "0.1.1",
  "description": "Process Monitor — standalone WinCC OA WebUI page: pmon manager console (status + start/stop/restart + restart-all) and project ZIP upload/deploy (optional folder purge, 7-Zip extraction, config.env, optional restart) with GxP audit-trail tracing. DPL import is handled elsewhere.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page"
  ],
  "license": "MIT",
  "dependencies": {
    "@visuelconcept-winccoa/wui-app-security": "^0.1.0",
    "@visuelconcept-winccoa/wui-kit": "^0.1.0",
    "@visuelconcept-winccoa/wui-para": "^0.1.0"
  },
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-ix-wrappers": "*",
    "@wincc-oa/wui-models": "*",
    "@wincc-oa/wui-oarxjs-context": "*",
    "@wincc-oa/wui-shared": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "requires": [
      "para",
      "app-security"
    ],
    "route": "/process-monitor",
    "routeId": "process-monitor",
    "component": "wui-process-monitor",
    "module": "/data/dashboard-wc/pages/process-monitor.js",
    "icon": "monitor",
    "permission": [
      "connected"
    ],
    "tier": 3,
    "backend": {
      "mount": "/api/process-monitor",
      "routeClass": "ProcessMonitorRoute",
      "routeFile": "processMonitorRoute",
      "files": [
        "processMonitorController.ts",
        "processMonitorRoute.ts"
      ],
      "shared": [
        "@visuelconcept-winccoa/wui-app-security/appSecurityGuard.ts"
      ],
      "managers": [
        "processMonitor"
      ],
      "notes": [
        "/api/process-monitor/*"
      ]
    }
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@wincc-oa/wui-i18n-shared": {
      "optional": true
    },
    "@wincc-oa/wui-ix-wrappers": {
      "optional": true
    },
    "@wincc-oa/wui-models": {
      "optional": true
    },
    "@wincc-oa/wui-oarxjs-context": {
      "optional": true
    },
    "@wincc-oa/wui-shared": {
      "optional": true
    }
  },
  "files": [
    "src",
    "backend",
    "managers",
    "menu.fragment.jsonc",
    "!**/*.spec.ts",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept-winccoa/winccoa-wui-pages.git",
    "directory": "libs/wui-process-monitor"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
