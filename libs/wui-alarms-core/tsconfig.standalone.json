{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": "../..",
    "paths": {
      "@visuelconcept/wui-kit/*": [
        "libs/wui-kit/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
