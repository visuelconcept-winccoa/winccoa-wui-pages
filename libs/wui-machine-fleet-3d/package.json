{
  "name": "@visuelconcept-winccoa/wui-machine-fleet-3d",
  "type": "module",
  "version": "0.2.0",
  "description": "Machine Fleet 3D — standalone WinCC OA WebUI page: multi-atelier 3D digital twin (Three.js) with live DP-bound machine state/KPIs, config UI, GLB/billboard library and dashboard export. The per-machine dashboard embeds the shared alarm view (standing alarms or the archived ones over the dashboard's period, scoped to the machine's datapoints). Hub page; depends on the fleet-core + ai-kit + alarms-core domain kits.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page"
  ],
  "license": "MIT",
  "dependencies": {
    "@visuelconcept-winccoa/wui-ai-kit": "^0.1.0",
    "@visuelconcept-winccoa/wui-alarms-core": "^0.3.0",
    "@visuelconcept-winccoa/wui-fleet-core": "^0.1.0",
    "@visuelconcept-winccoa/wui-fleet-kpi-analysis": "^0.1.0",
    "@visuelconcept-winccoa/wui-kit": "^0.1.0",
    "three": "^0.169.0",
    "@visuelconcept-winccoa/wui-para": "^0.1.0",
    "@visuelconcept-winccoa/wui-app-security": "^0.1.0"
  },
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "tsyringe": "*",
    "@etm-professional-control/oa-rx-js-api": "*",
    "@wincc-oa/wui-dashboard-data": "*",
    "@wincc-oa/wui-data-selector-data": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-ix-wrappers": "*",
    "@wincc-oa/wui-models": "*",
    "@wincc-oa/wui-oarxjs-context": "*",
    "@wincc-oa/wui-shared": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "requires": [
      "para",
      "app-security"
    ],
    "route": "/fleet-3d",
    "routes": [
      "/fleet-3d",
      "/fleet-3d/:atelier"
    ],
    "routeId": "fleet-3d",
    "component": "wui-machine-fleet-3d",
    "module": "/data/dashboard-wc/pages/machine-fleet-3d.js",
    "icon": "capacity",
    "tier": 2,
    "assets": [
      "data/dashboard-wc/semifab-icons/** (billboard textures)"
    ],
    "backend": {
      "mount": "/api/ai",
      "routeClass": "AiRoute",
      "routeFile": "aiRoute",
      "files": [
        "aiRoute.ts",
        "fleetAteliers.ts"
      ],
      "shared": [
        "@visuelconcept-winccoa/wui-ai-kit/aiController.ts",
        "@visuelconcept-winccoa/wui-app-security/appSecurityGuard.ts"
      ],
      "managers": [
        "machineSim",
        "kpiCalc",
        "aiAssistant"
      ],
      "notes": [
        "/api/ai/chat (optional, AI assistant via wui-ai-kit's aiController)",
        "/api/ai/fleet/workshops[/:id] (read only, role view: the ateliers for hosts that embed <wui-fleet-3d-view> — see docs/wui-machine-fleet-3d/EMBEDDING.md)",
        "machineSim (optional, simulation)",
        "kpiCalc (optional, real-time TRS/MTBF/MTTR)"
      ]
    },
    "showcase": {
      "entry": "/fleet-3d",
      "caption": {
        "fr": "Les ateliers de l’usine",
        "en": "The plant’s workshops",
        "de": "Die Werkstätten des Werks"
      },
      "steps": [
        {
          "click": "mf-atelier-overview ix-card.card >> nth=0",
          "caption": {
            "fr": "L’atelier en 3D : chaque machine avec son état",
            "en": "The workshop in 3D: every machine with its state",
            "de": "Die Werkstatt in 3D: jede Maschine mit ihrem Zustand"
          },
          "slow": 8,
          "pause": 2.5
        },
        {
          "click": "ix-icon-button[icon='app-menu']",
          "caption": {
            "fr": "Les machines, celles qui demandent attention en tête",
            "en": "The machines, those needing attention first",
            "de": "Die Maschinen, die mit Handlungsbedarf zuerst"
          },
          "pause": 1
        },
        {
          "click": "mf-config-panel .row >> nth=0",
          "slow": 8,
          "caption": {
            "fr": "Zoom sur une machine en alerte",
            "en": "Zooming in on a machine in alert",
            "de": "Zoom auf eine Maschine im Alarm"
          },
          "pause": 2
        },
        {
          "click": "mf-config-panel .row >> nth=1",
          "slow": 8,
          "caption": {
            "fr": "Une autre, à l’arrêt : son état et ses mesures",
            "en": "Another one, stopped: its state and readings",
            "de": "Eine weitere, gestoppt: Zustand und Messwerte"
          },
          "pause": 2
        },
        {
          "click": "div.nav ix-icon-button[icon='home']",
          "slow": 8,
          "caption": {
            "fr": "Retour à la vue d’ensemble",
            "en": "Back to the overview",
            "de": "Zurück zur Gesamtansicht"
          },
          "pause": 1.5
        }
      ]
    }
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "tsyringe": {
      "optional": true
    },
    "@etm-professional-control/oa-rx-js-api": {
      "optional": true
    },
    "@wincc-oa/wui-dashboard-data": {
      "optional": true
    },
    "@wincc-oa/wui-data-selector-data": {
      "optional": true
    },
    "@wincc-oa/wui-i18n-shared": {
      "optional": true
    },
    "@wincc-oa/wui-ix-wrappers": {
      "optional": true
    },
    "@wincc-oa/wui-models": {
      "optional": true
    },
    "@wincc-oa/wui-oarxjs-context": {
      "optional": true
    },
    "@wincc-oa/wui-shared": {
      "optional": true
    }
  },
  "files": [
    "src",
    "backend",
    "managers",
    "oa-data",
    "menu.fragment.jsonc",
    "mock",
    "!**/*.spec.ts",
    "!**/*.spec.mjs",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept-winccoa/winccoa-wui-pages.git",
    "directory": "libs/wui-machine-fleet-3d"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@types/three": "~0.169.0"
  }
}
