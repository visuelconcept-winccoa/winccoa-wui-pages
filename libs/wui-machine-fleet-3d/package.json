{
  "name": "@visuelconcept-winccoa/wui-machine-fleet-3d",
  "type": "module",
  "version": "0.1.0",
  "description": "Machine Fleet 3D — standalone WinCC OA WebUI page: multi-atelier 3D digital twin (Three.js) with live DP-bound machine state/KPIs, config UI, GLB/billboard library and dashboard export. The per-machine dashboard embeds the shared alarm view (standing alarms or the archived ones over the dashboard's period, scoped to the machine's datapoints). Hub page; depends on the fleet-core + ai-kit + alarms-core domain kits.",
  "author": {
    "name": "Visuel Concept"
  },
  "keywords": [
    "OpenArchitecture",
    "WinCCOA",
    "dashboard",
    "webcomponents",
    "standalone-page"
  ],
  "license": "MIT",
  "dependencies": {
    "@visuelconcept-winccoa/wui-ai-kit": "^0.1.0",
    "@visuelconcept-winccoa/wui-alarms-core": "^0.1.0",
    "@visuelconcept-winccoa/wui-fleet-core": "^0.1.0",
    "@visuelconcept-winccoa/wui-fleet-kpi-analysis": "^0.1.0",
    "@visuelconcept-winccoa/wui-kit": "^0.1.0",
    "three": "^0.169.0"
  },
  "peerDependencies": {
    "lit": "*",
    "rxjs": "*",
    "tsyringe": "*",
    "@etm-professional-control/oa-rx-js-api": "*",
    "@wincc-oa/wui-dashboard-data": "*",
    "@wincc-oa/wui-data-selector-data": "*",
    "@wincc-oa/wui-i18n-shared": "*",
    "@wincc-oa/wui-ix-wrappers": "*",
    "@wincc-oa/wui-models": "*",
    "@wincc-oa/wui-oarxjs-context": "*",
    "@wincc-oa/wui-shared": "*"
  },
  "exports": {
    "./*": {
      "types": "./types/*",
      "import": "./*"
    }
  },
  "wuiPage": {
    "route": "/fleet-3d",
    "routes": [
      "/fleet-3d",
      "/fleet-3d/:atelier"
    ],
    "routeId": "fleet-3d",
    "component": "wui-machine-fleet-3d",
    "module": "/data/dashboard-wc/pages/machine-fleet-3d.js",
    "icon": "capacity",
    "tier": 2,
    "assets": [
      "data/dashboard-wc/semifab-icons/** (billboard textures)"
    ],
    "backend": {
      "mount": "/api/ai",
      "routeClass": "AiRoute",
      "routeFile": "aiRoute",
      "shared": [
        "@visuelconcept-winccoa/wui-ai-kit/aiController.ts",
        "@visuelconcept-winccoa/wui-ai-kit/aiRoute.ts"
      ],
      "managers": [
        "machineSim",
        "kpiCalc",
        "aiAssistant"
      ],
      "notes": [
        "/api/ai/chat (optional, AI assistant via wui-ai-kit)",
        "machineSim (optional, simulation)",
        "kpiCalc (optional, real-time TRS/MTBF/MTTR)"
      ]
    }
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "tsyringe": {
      "optional": true
    },
    "@etm-professional-control/oa-rx-js-api": {
      "optional": true
    },
    "@wincc-oa/wui-dashboard-data": {
      "optional": true
    },
    "@wincc-oa/wui-data-selector-data": {
      "optional": true
    },
    "@wincc-oa/wui-i18n-shared": {
      "optional": true
    },
    "@wincc-oa/wui-ix-wrappers": {
      "optional": true
    },
    "@wincc-oa/wui-models": {
      "optional": true
    },
    "@wincc-oa/wui-oarxjs-context": {
      "optional": true
    },
    "@wincc-oa/wui-shared": {
      "optional": true
    }
  },
  "files": [
    "src",
    "managers",
    "menu.fragment.jsonc",
    "!**/*.spec.ts",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept-winccoa/winccoa-wui-pages.git",
    "directory": "libs/wui-machine-fleet-3d"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
